# oauth2-proxy: forward-auth for Traefik. Protects signals.alexgs.me.
# Copy this file to `oauth2-proxy.env` and fill in actual values.

# GitHub OAuth App, not a GitHub App (github.com/settings/developers >
# OAuth Apps). Its client ID starts with "Ov23li"; a GitHub App's starts
# with "Iv23li" and fails at the callback because it can't read emails.
#   Homepage URL:               https://signals.alexgs.me
#   Authorization callback URL: https://signals.alexgs.me/oauth2/callback
OAUTH2_PROXY_PROVIDER=github
OAUTH2_PROXY_CLIENT_ID=XXXXXXXXXXXXXXXXXXXX
OAUTH2_PROXY_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OAUTH2_PROXY_REDIRECT_URL=https://signals.alexgs.me/oauth2/callback

# Only this GitHub account may sign in. The email check is left open because
# the user check does the restricting.
OAUTH2_PROXY_GITHUB_USERS=alexgs
OAUTH2_PROXY_EMAIL_DOMAINS=*

# Generate with: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OAUTH2_PROXY_COOKIE_SECURE=true

# Forward-auth mode: answer 202 for signed-in requests, read the original
# host and path from Traefik's X-Forwarded-* headers, and send everyone
# else straight to GitHub instead of a sign-in page.
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_UPSTREAMS=static://202
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# The post-login redirect is built from X-Forwarded-Host, so it's an absolute
# URL. oauth2-proxy rejects absolute redirects to hosts not listed here.
OAUTH2_PROXY_WHITELIST_DOMAINS=signals.alexgs.me
