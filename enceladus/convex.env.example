# Environment variables for Convex service
# Copy this file to `convex.env` and fill in actual values

# Application environment
NODE_ENV=production

# Clerk Authentication (PRODUCTION KEYS)
# Get these from https://dashboard.clerk.com (switch to Production)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Clerk URLs (usually same as dev)
PUBLIC_CLERK_SIGN_IN_URL=/sign-in
PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenAI API Key (PRODUCTION KEY)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Anthropic API Key (PRODUCTION KEY)
# Get your key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# FontAwesome Pro (same token as dev)
FONTAWESOME_NPM_AUTH_TOKEN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

GITHUB_OAUTH_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_OAUTH_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXX
